{
  "name": "@axium-lab/euro-pii",
  "version": "1.0.1",
  "description": "Europe-first PII detection and anonymization: regex, checksums and context words. Zero dependencies.",
  "keywords": [
    "pii",
    "gdpr",
    "anonymization",
    "anonymize",
    "redaction",
    "redact",
    "privacy",
    "personal-data",
    "data-protection",
    "europe",
    "eu",
    "dni",
    "nif",
    "iban",
    "checksum",
    "regex",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:axium-lab/euro-pii.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun tests/methods/documents.ts && bun tests/methods/options.ts",
    "manual": "bun tests/manual.ts",
    "dev": "bun --watch tests/manual.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
